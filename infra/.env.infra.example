# GCP Infrastructure Configuration
# Copy to .env.infra and fill in your values. NEVER commit .env.infra to git.

# GCP billing account ID (format: XXXXXX-XXXXXX-XXXXXX)
BILLING_ACCOUNT_ID=

# GCP project ID (globally unique, lowercase + hyphens)
PROJECT_ID=bsky-feed-consumer

# Region/zone for all resources
REGION=us-central1
ZONE=us-central1-a

# DNS subdomain to manage (e.g., bsky.example.com)
# A Cloud DNS zone will be created for this; you'll add NS delegation in your parent domain.
DNS_SUBDOMAIN=

# Application secrets (will be stored in Secret Manager)
BSKY_API_KEY=
BSKY_ANTHROPIC_API_KEY=

# Cloud SQL
DB_PASSWORD=
